diff --git a/hypervisor/src/mshv/pmem_cow.rs b/hypervisor/src/mshv/pmem_cow.rs
new file mode 100644
index 0000000..91958b1
--- /dev/null
+++ b/hypervisor/src/mshv/pmem_cow.rs
@@ -0,0 +1,289 @@
+// Copyright (c) 2026 Microsoft Corporation.
+// SPDX-License-Identifier: Apache-2.0 OR BSD-3-Clause
+
+use std::collections::BTreeMap;
+use std::sync::Arc;
+use std::{io, ptr};
+
+use anyhow::{Context, Result, ensure};
+use log::info;
+use mshv_bindings::{MSHV_SET_MEM_BIT_EXECUTABLE, MSHV_SET_MEM_BIT_WRITABLE, mshv_user_mem_region};
+use mshv_ioctls::VmFd;
+use vm_memory::{
+    MmapRegion,
+    bitmap::{AtomicBitmap, Bitmap},
+};
+
+const PAGE_SIZE: u64 = 4096;
+// This MSHV kernel rejects compound file-cache folios smaller than 2 MiB
+// when considering a 512-page huge mapping. Shorter regions force 4 KiB
+// mappings without changing the backing folios or kernel.
+const MAX_REGION_SIZE: u64 = 511 * PAGE_SIZE;
+
+fn exclude_from_dump<B: Bitmap>(region: &MmapRegion<B>) -> Result<()> {
+    // SAFETY: region owns this complete mapping for the duration of this call.
+    let ret = unsafe { libc::madvise(region.as_ptr().cast(), region.size(), libc::MADV_DONTDUMP) };
+    if ret != 0 {
+        return Err(io::Error::last_os_error()).context("MADV_DONTDUMP for PMEM");
+    }
+    Ok(())
+}
+
+struct CowRegion {
+    source: Arc<MmapRegion<AtomicBitmap>>,
+    mappings: BTreeMap<u64, mshv_user_mem_region>,
+    private_pages: Vec<MmapRegion<()>>,
+}
+
+#[derive(Default)]
+pub(super) struct PmemCow {
+    pub(super) vcpu_count: usize,
+    regions: BTreeMap<u64, CowRegion>,
+}
+
+fn mapping(gpa: u64, hva: u64, size: u64, writable: bool) -> mshv_user_mem_region {
+    mshv_user_mem_region {
+        guest_pfn: gpa / PAGE_SIZE,
+        userspace_addr: hva,
+        size,
+        flags: (1 << MSHV_SET_MEM_BIT_EXECUTABLE)
+            | if writable {
+                1 << MSHV_SET_MEM_BIT_WRITABLE
+            } else {
+                0
+            },
+        ..Default::default()
+    }
+}
+
+fn shared_mappings(gpa: u64, hva: u64, size: u64) -> impl Iterator<Item = mshv_user_mem_region> {
+    (0..size)
+        .step_by(MAX_REGION_SIZE as usize)
+        .map(move |offset| {
+            mapping(
+                gpa + offset,
+                hva + offset,
+                (size - offset).min(MAX_REGION_SIZE),
+                false,
+            )
+        })
+}
+
+fn split_mapping(
+    original: mshv_user_mem_region,
+    page_gpa: u64,
+    private_hva: u64,
+) -> Vec<mshv_user_mem_region> {
+    let start = original.guest_pfn * PAGE_SIZE;
+    let end = start + original.size;
+    let mut result = Vec::with_capacity(3);
+    if page_gpa > start {
+        result.push(mapping(
+            start,
+            original.userspace_addr,
+            page_gpa - start,
+            false,
+        ));
+    }
+    result.push(mapping(page_gpa, private_hva, PAGE_SIZE, true));
+    if page_gpa + PAGE_SIZE < end {
+        result.push(mapping(
+            page_gpa + PAGE_SIZE,
+            original.userspace_addr + page_gpa + PAGE_SIZE - start,
+            end - page_gpa - PAGE_SIZE,
+            false,
+        ));
+    }
+    result
+}
+
+impl PmemCow {
+    pub(super) fn active(&self) -> bool {
+        !self.regions.is_empty()
+    }
+
+    pub(super) fn register(
+        &mut self,
+        vm: &VmFd,
+        gpa: u64,
+        source: Arc<MmapRegion<AtomicBitmap>>,
+    ) -> Result<()> {
+        ensure!(
+            self.vcpu_count <= 1,
+            "experimental PMEM CoW requires one vCPU"
+        );
+        let size = source.size() as u64;
+        let end = gpa.checked_add(size).context("PMEM address overflow")?;
+        ensure!(
+            size != 0 && gpa.is_multiple_of(PAGE_SIZE) && size.is_multiple_of(PAGE_SIZE),
+            "PMEM CoW region must be page aligned"
+        );
+        for (&base, region) in &self.regions {
+            ensure!(
+                end <= base || gpa >= base + region.source.size() as u64,
+                "overlapping PMEM CoW regions"
+            );
+        }
+        exclude_from_dump(source.as_ref())?;
+        let hva = source.as_ptr() as u64;
+        let region = self.regions.entry(gpa).or_insert(CowRegion {
+            source,
+            mappings: BTreeMap::new(),
+            private_pages: Vec::new(),
+        });
+        for original in shared_mappings(gpa, hva, size) {
+            vm.map_user_memory(original)
+                .context("register shared read-only PMEM")?;
+            region
+                .mappings
+                .insert(original.guest_pfn * PAGE_SIZE, original);
+        }
+        Ok(())
+    }
+
+    pub(super) fn handle_write(&mut self, vm: &VmFd, gpa: u64) -> Result<bool> {
+        let Some((&base, region)) = self.regions.range_mut(..=gpa).next_back() else {
+            return Ok(false);
+        };
+        if gpa - base >= region.source.size() as u64 {
+            return Ok(false);
+        }
+        let page_gpa = gpa & !(PAGE_SIZE - 1);
+        let (&start, original) = region
+            .mappings
+            .range(..=page_gpa)
+            .next_back()
+            .context("missing PMEM CoW mapping")?;
+        let original = *original;
+        ensure!(
+            page_gpa - start < original.size,
+            "guest write outside registered PMEM mapping"
+        );
+        ensure!(
+            original.flags & (1 << MSHV_SET_MEM_BIT_WRITABLE) == 0,
+            "unexpected write fault on private writable PMEM"
+        );
+        let private =
+            MmapRegion::<()>::new(PAGE_SIZE as usize).context("allocate private PMEM page")?;
+        exclude_from_dump(&private)?;
+        // SAFETY: the source offset is within the owned source mapping. Only one
+        // vCPU is supported, and it is stopped at this write intercept.
+        unsafe {
+            ptr::copy_nonoverlapping(
+                region.source.as_ptr().add((page_gpa - base) as usize),
+                private.as_ptr(),
+                PAGE_SIZE as usize,
+            );
+        }
+        let replacements = split_mapping(original, page_gpa, private.as_ptr() as u64);
+        // Retain the allocation even if a subsequent ioctl fails: any successful
+        // mapping must keep valid backing until the VM is torn down.
+        region.private_pages.push(private);
+        vm.unmap_user_memory(original)
+            .context("unmap PMEM CoW extent")?;
+        region.mappings.remove(&start);
+        for replacement in replacements {
+            vm.map_user_memory(replacement)
+                .context("remap PMEM CoW extent")?;
+            region
+                .mappings
+                .insert(replacement.guest_pfn * PAGE_SIZE, replacement);
+        }
+        info!(
+            "PMEM CoW: GPA {page_gpa:#x}, {} private pages ({} bytes)",
+            region.private_pages.len(),
+            region.private_pages.len() * PAGE_SIZE as usize
+        );
+        Ok(true)
+    }
+
+    pub(super) fn contains(&self, gpa: u64) -> bool {
+        self.regions
+            .range(..=gpa)
+            .next_back()
+            .is_some_and(|(&base, region)| gpa - base < region.source.size() as u64)
+    }
+
+    pub(super) fn unregister(
+        &mut self,
+        vm: &VmFd,
+        gpa: u64,
+        hva: u64,
+        size: usize,
+    ) -> Result<bool> {
+        let Some(region) = self.regions.get_mut(&gpa) else {
+            return Ok(false);
+        };
+        ensure!(
+            region.source.as_ptr() as u64 == hva && region.source.size() == size,
+            "PMEM CoW unmap does not match registered region"
+        );
+        while let Some((&start, original)) = region.mappings.first_key_value() {
+            vm.unmap_user_memory(*original)
+                .context("unregister PMEM CoW extent")?;
+            region.mappings.remove(&start);
+        }
+        self.regions.remove(&gpa);
+        Ok(true)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn shared_extents_avoid_unsupported_compound_folio_stride() {
+        for pages in [1, 511, 512, 1024, 65536] {
+            let size = pages * PAGE_SIZE;
+            let parts: Vec<_> = shared_mappings(0x200000, 0x1000000, size).collect();
+            let mut covered = 0;
+            for part in parts {
+                assert!(part.size > 0 && part.size < 512 * PAGE_SIZE);
+                assert_eq!({ part.guest_pfn }, (0x200000 + covered) / PAGE_SIZE);
+                assert_eq!({ part.userspace_addr }, 0x1000000 + covered);
+                covered += part.size;
+            }
+            assert_eq!(covered, size);
+        }
+    }
+
+    #[test]
+    fn splits_only_the_guest_written_page() {
+        for page in [0x1000, 0x2000, 0x3000] {
+            let parts = split_mapping(mapping(0x1000, 0x10000, 0x3000, false), page, 0x80000);
+            assert_eq!(parts.iter().map(|part| part.size).sum::<u64>(), 0x3000);
+            let writable: Vec<_> = parts
+                .iter()
+                .filter(|part| part.flags & (1 << MSHV_SET_MEM_BIT_WRITABLE) != 0)
+                .collect();
+            assert_eq!(writable.len(), 1);
+            assert_eq!({ writable[0].guest_pfn }, page / PAGE_SIZE);
+            assert_eq!({ writable[0].size }, PAGE_SIZE);
+            assert_eq!({ writable[0].userspace_addr }, 0x80000);
+            for part in &parts {
+                if part.flags & (1 << MSHV_SET_MEM_BIT_WRITABLE) == 0 {
+                    assert_eq!(
+                        { part.userspace_addr },
+                        0x10000 + part.guest_pfn * PAGE_SIZE - 0x1000
+                    );
+                }
+            }
+            for pair in parts.windows(2) {
+                assert_eq!(
+                    pair[0].guest_pfn * PAGE_SIZE + pair[0].size,
+                    pair[1].guest_pfn * PAGE_SIZE
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn promotes_the_last_remaining_read_only_page() {
+        let parts = split_mapping(mapping(0x2000, 0x11000, PAGE_SIZE, false), 0x2000, 0x80000);
+        assert_eq!(parts.len(), 1);
+        assert_eq!({ parts[0].userspace_addr }, 0x80000);
+        assert_eq!({ parts[0].size }, PAGE_SIZE);
+        assert_ne!(parts[0].flags & (1 << MSHV_SET_MEM_BIT_WRITABLE), 0);
+    }
+}
