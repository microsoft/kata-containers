# Support mmconfig PCI config space access.
# It's used to enable the MMIO access method for PCIe devices.
CONFIG_PCI_MMCONFIG=y

# Support for loading modules and firmware
# It is used to support loading GPU drivers.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_FW_LOADER=y

# Linux kernel version suffix
CONFIG_LOCALVERSION="-azure-gpus${CONF_GUEST_SUFFIX}"

# Newer NVIDIA drivers need additional symbols
CONFIG_X86_MCE=y
CONFIG_ARCH_SUPPORTS_MEMORY_FAILURE=y
CONFIG_X86_SUPPORTS_MEMORY_FAILURE=y
CONFIG_MEMORY_FAILURE=y
CONFIG_MTRR=y
CONFIG_X86_PAT=y

# NVIDIA UVM enables UVM_IS_CONFIG_HMM only when both CONFIG_HMM_MIRROR and
# CONFIG_DEVICE_PRIVATE are set. HMM_MIRROR is a promptless, select-only symbol
# (mm/Kconfig), so a bare CONFIG_HMM_MIRROR=y is silently dropped; enable an
# in-tree selector that does `select HMM_MIRROR`. TEST_HMM is the lightest one
# (needs TRANSPARENT_HUGEPAGE + DEVICE_PRIVATE, pulls in no GPU/DRM stack); its
# module is built but never loaded. kata builds the config with
# `merge_config.sh -r -n` (allnoconfig base), which forces every prompted symbol
# and menuconfig gate off unless a fragment sets it. TEST_HMM lives under
# `if RUNTIME_TESTING_MENU`, so that gate must be enabled here or TEST_HMM is
# dropped and nothing selects HMM_MIRROR.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_DEVICE_PRIVATE=y
CONFIG_RUNTIME_TESTING_MENU=y
CONFIG_TEST_HMM=m

# CC related configs
CONFIG_CRYPTO_ECC=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_ECDSA=y

# Dependency of _CRYPTO_
CONFIG_MODULE_SIG=y

# Mellanox ConnectX (mlx5) + InfiniBand/RoCE are provided built-in (=y) by
# fragments/common/mlx5.conf, which is merged into every kernel build. Do NOT
# redefine those symbols here: build-kernel.sh's merge_config check dies on a
# redundant/redefined CONFIG (the previous =m block here conflicted with
# common's =y once common/mlx5.conf was added). Built-in means cold-plugged
# CX5/CX6 VFs bind at guest PCI enumeration and expose /dev/infiniband without
# NVRC having to modprobe them (an IB-only pod dispatches to NVRC's no-op cpu
# mode).

# Build requirement of the Microsoft Azure Linux (CBL-Mariner) x86_64 kernel
# (mirrors the same fix in nvidia-azure-repackaged.arm64.conf.in). Its
# arch/x86/kernel/cpu/mshyperv.c defines hv_resvd_ranges[HV_MAX_RESVD_RANGES]
# at file scope and calls hv_dump_mshv_memory() / references hv_mshv_res[],
# all of which asm-generic/mshyperv.h declares only inside
# `#if IS_ENABLED(CONFIG_HYPERV)`. With Hyper-V off the UVM kernel fails to
# compile (arch/x86/kernel/cpu/mshyperv.o: 'HV_MAX_RESVD_RANGES' /
# 'hv_mshv_res' undeclared, implicit 'hv_dump_mshv_memory'). Enable the Hyper-V
# guest enlightenments so the build succeeds; they are inert under OpenVMM
# (vmbus probes, finds no Hyper-V, stays dormant). Not needed for the upstream
# NVIDIA/mainline tree, only the MS Azure Linux source.
CONFIG_HYPERV=y
