ARG IMAGE_REGISTRY=mcr.microsoft.com
FROM ${IMAGE_REGISTRY}/azurelinux/base/core:@OS_VERSION@

RUN tdnf -y install \
    ca-certificates \
    build-essential \
    dnf \
    git \
    tar \
    xz \
    zstd

# pin cosign to 3.0.2 (raw sigstore binary; Azure Linux has no cosign package).
# Needed by nvidia_rootfs.sh::setup_nvidia-nvrc to cosign-verify the NVRC blob.
RUN ARCH=$(uname -m); \
	cosign_arch=""; \
	case "${ARCH}" in \
		"aarch64") cosign_arch="arm64" ;; \
		"x86_64") cosign_arch="amd64" ;; \
		*) echo "Unsupported architecture for cosign: ${ARCH}" && exit 0 ;; \
	esac; \
	curl -O -L "https://github.com/sigstore/cosign/releases/download/v3.0.2/cosign-linux-${cosign_arch}" && \
	# Verify the checksum instead of using cosign to verify itself (chicken-and-egg). \
	curl -O -L "https://github.com/sigstore/cosign/releases/download/v3.0.2/cosign_checksums.txt" && \
	grep -E "cosign-linux-${cosign_arch}$" cosign_checksums.txt | sha256sum --check - && \
	install -m 0755 "cosign-linux-${cosign_arch}" /usr/local/bin/cosign && \
	rm -f "cosign-linux-${cosign_arch}" cosign_checksums.txt

@INSTALL_RUST@
